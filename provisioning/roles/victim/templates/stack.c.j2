/* stack.c
 * Vulnerable program - SEED Labs Buffer Overflow Vulnerability Lab.
 * BUF_SIZE is fixed for this machine - it is NOT the same value on every
 * student's sandbox, so an offset that works elsewhere will not work here.
 */
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

#ifndef BUF_SIZE
#define BUF_SIZE {{ buf_size }}
#endif

int bof(char *str)
{
    char buffer[BUF_SIZE];

    /* The following statement has a buffer overflow problem */
    strcpy(buffer, str);
    return 1;
}

int main(int argc, char **argv)
{
    char str[517];
    FILE *badfile;

    /* Need to use the array at least once */
    char dummy[BUF_SIZE];
    memset(dummy, 0, BUF_SIZE);

    badfile = fopen("badfile", "r");
    if (badfile == NULL) {
        perror("badfile");
        return 1;
    }
    fread(str, sizeof(char), 517, badfile);
    fclose(badfile);
    bof(str);

    printf("Returned Properly\n");
    return 1;
}
